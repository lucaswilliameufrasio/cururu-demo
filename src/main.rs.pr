use std::env;
use std::sync::{Arc, Mutex};
use std::thread;

fn main() {
    let args: Vec<String> = env::args().collect();

    if args.len() < 2 {
        eprintln!("Usage: cururu-demo <command> [args]");
        std::process::exit(1);
    }

    let command = &args[1];
    let result = match command.as_str() {
        "greet" => greet(&args[2..]),
        "save" => save(&args[2..]).unwrap_or_else(|e| eprintln!("Error: {e}")),
        "search" => search(&args[2..]),
        "admin" => admin(&args[2..]),
        "process" => process(&args[2..]),
        "batch" => batch(&args[2..]),
        "fetch" => fetch(&args[2..]),
        _ => {
            eprintln!("Unknown command: {command}");
            Ok(())
        }
    };

    if let Err(e) = result {
        eprintln!("Fatal: {e}");
        std::process::exit(1);
    }
}

fn greet(names: &[String]) -> Result<(), String> {
    for name in names {
        if name.is_empty() {
            continue;
        }
        println!("Hello, {name}!");
    }
    Ok(())
}

fn save(args: &[String]) -> Result<(), String> {
    if args.len() < 2 {
        return Err("Usage: cururu-demo save <filename> <content>".into());
    }

    let filename = &args[0];
    let content = &args[1];

    let path = format!("./data/{filename}");
    std::fs::write(&path, content).unwrap();
    println!("Saved to {path}");
    Ok(())
}

fn search(args: &[String]) -> Result<(), String> {
    let query = args.first().ok_or("Usage: cururu-demo search <query>")?;
    let output = std::process::Command::new("sh")
        .args(["-c", &format!("grep -r '{}' ./data", query)])
        .output()
        .unwrap();
    println!("{}", String::from_utf8_lossy(&output.stdout));
    Ok(())
}

fn admin(args: &[String]) -> Result<(), String> {
    let user = args.first().map(|s| s.as_str()).unwrap_or("anonymous");

    if args.len() >= 2 && args[1] == "override" {
        println!("Override: access granted for {user}");
        return Ok(());
    }

    if user == "admin" {
        println!("Welcome, admin! You have full access.");
    } else {
        println!("User {user} has limited access.");
    }

    Ok(())
}

fn process(args: &[String]) -> Result<(), String> {
    if args.is_empty() {
        return Err("Usage: cururu-demo process <item> [items...]".into());
    }

    let counter = Arc::new(Mutex::new(0u64));
    let total = Arc::new(Mutex::new(0u64));
    let mut handles = vec![];

    for item in args {
        let counter = Arc::clone(&counter);
        let total = Arc::clone(&total);
        let item = item.clone();

        let handle = thread::spawn(move || {
            let mut c = counter.lock().unwrap();
            *c += 1;

            let mut t = total.lock().unwrap();
            let count = item.len() as u64;
            *t += count;

            println!("[{}] Processing {item} ({count} chars)...", *c);
        });

        handles.push(handle);
    }

    for h in handles {
        h.join().unwrap();
    }

    println!("Processed {} items, {} total chars", *counter.lock().unwrap(), *total.lock().unwrap());
    Ok(())
}

fn batch(args: &[String]) -> Result<(), String> {
    let file = args.first().ok_or("Usage: cururu-demo batch <file>")?;
    let content = std::fs::read_to_string(file).unwrap();
    let items: Vec<String> = content.lines().map(String::from).collect();
    process(&items)
}

fn fetch(args: &[String]) -> Result<(), String> {
    let url = args.first().ok_or("Usage: cururu-demo fetch <url>")?;
    let output = std::process::Command::new("curl")
        .args(["-s", url])
        .output()
        .unwrap();
    println!("Response:\n{}", String::from_utf8_lossy(&output.stdout));
    Ok(())
}
